# --- Twilio credentials (Console -> Account Settings -> API Keys & Credentials) ---
# A "regular" API key works. Do NOT use a Messaging-only key.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Console -> Account Settings -> Auth Token (used to verify webhook signatures)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Your Twilio phone number ---
# Format: +15551234567 (E.164, no spaces)
TWILIO_OUTBOUND_PHONE_NUMBER=+15551234567
# Caller ID shown on outbound calls. Must be this number, or a
# Verified / Hosted Caller ID in Twilio Console -> Voice -> Caller ID.
TWILIO_CALLER_ID=

# --- Routing identity for the app device ---
# The app registers under this identity, and inbound calls ring it.
DEFAULT_CLIENT_IDENTITY=default

# --- Server-side call recording ---
# dual = stereo both legs | single = mono | none = off
# NOTE: Twilio cannot record a leg that ends in <Client>, so inbound-to-app
#       calls are recorded by the app itself; outbound calls are recorded here.
RECORD_CALLS=dual

# Optional: shared secret the Android app must send (X-App-Key) to reach
# /api/token, /api/history and /api/recordings. Leave empty to allow anyone.
APP_SHARED_SECRET=

# Filled in after the first deploy (Vercel URL):
STATUS_CALLBACK_URL=
CLIENT_TWIML_URL=
ACCESS_TOKEN_TTL_SECONDS=3600

# --- TwiML Application (Console -> Voice -> TwiML Apps -> Create App) ---
# REQUIRED for outbound calling. The Voice SDK refuses to connect unless the
# access token carries voice.outgoing.application_sid.
# In the TwiML App, set the Voice hook "When a call is received from a TwiML
# Client" to Method POST, URL https://<host>/api/twiml/voice
TWILIO_TWIML_APP_SID=
