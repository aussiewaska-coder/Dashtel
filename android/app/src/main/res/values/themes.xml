<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dialer" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#54E09A</item>
        <item name="android:statusBarColor">#090C10</item>
        <item name="android:navigationBarColor">#090C10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#090C10</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Dialer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090C10</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Dialer</item>
    </style>
</resources>
